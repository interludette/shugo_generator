<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>나만의 수호캐 생성기</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400;1,700&display=swap" rel="stylesheet"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:#0a0a0f;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;font-family:'Playfair Display',serif}
    .app{width:100%;max-width:520px}
    .header{text-align:center;margin-bottom:36px}
    .header-sub{font-size:10px;letter-spacing:5px;color:#7c5c8a;text-transform:uppercase;margin-bottom:12px}
    .header-title{font-size:36px;font-style:italic;color:#f0e6f6;line-height:1.1;margin-bottom:6px}
    .header-title span{color:#c084d4}
    .header-desc{font-size:12px;color:#7a6a8a;letter-spacing:1px;margin-top:8px}
    .lace{width:100%;margin:4px 0 28px}
    .form-block{margin-bottom:20px}
    .form-label{font-size:11px;letter-spacing:3px;color:#9b6bae;text-transform:uppercase;margin-bottom:8px;display:block}
    .form-input{width:100%;background:#12101a;border:1px solid #2d1f3d;border-radius:8px;padding:12px 16px;font-size:14px;color:#f0e6f6;font-family:'Playfair Display',serif;font-style:italic;outline:none;transition:border-color 0.2s}
    .form-input:focus{border-color:#9b6bae}
    .form-input::placeholder{color:#5a4a6a;font-style:italic}
    .options-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .opt-btn{background:#1a1525;border:1px solid #3d2a52;border-radius:8px;padding:10px 14px;font-size:13px;color:#c8b0e0;font-family:'Playfair Display',serif;cursor:pointer;transition:all 0.15s;text-align:left;line-height:1.4}
    .opt-btn:hover{border-color:#9b6bae;color:#f0e6f6;background:#221830}
    .opt-btn.selected{border-color:#c084d4;color:#f0e6f6;background:#2a1c3a}
    .generate-btn{width:100%;margin-top:24px;background:#2d1f3d;border:1px solid #7c5c8a;border-radius:8px;padding:14px;font-size:14px;color:#c084d4;font-family:'Playfair Display',serif;font-style:italic;cursor:pointer;letter-spacing:2px;transition:all 0.2s}
    .generate-btn:hover{background:#3d2a52;color:#f0e6f6}
    .generate-btn:disabled{opacity:0.4;cursor:not-allowed}
    .result-box{background:#12101a;border:1px solid #3d2a52;border-radius:12px;padding:28px 24px;margin-top:24px;display:none}
    .result-box.show{display:block}
    .result-label{font-size:10px;letter-spacing:4px;color:#7c5c8a;text-transform:uppercase;margin-bottom:16px}
    .result-name{font-size:28px;font-style:italic;color:#c084d4;margin-bottom:4px}
    .result-type{font-size:12px;letter-spacing:1px;color:#7a6a8a;margin-bottom:18px}
    .result-divider{height:1px;background:#2d1f3d;margin:16px 0}
    .result-text{font-size:13px;color:#c8b8d8;line-height:1.9;font-style:italic}
    .result-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:16px}
    .result-tag{font-size:10px;padding:3px 10px;border:1px solid #3d2a52;border-radius:20px;color:#9b6bae;letter-spacing:1px}
    .loading{text-align:center;padding:20px;color:#7a6a8a;font-style:italic;font-size:13px;display:none}
    .loading.show{display:block}
    .dot-anim::after{content:'...';animation:dots 1.2s infinite}
    @keyframes dots{0%{content:'.'}40%{content:'..'}80%{content:'...'}}
    .punk-deco{display:flex;align-items:center;justify-content:center;gap:12px;margin:16px 0}
    .punk-line{flex:1;height:1px;background:#2d1f3d}
    .punk-symbol{font-size:14px;color:#7c5c8a}
    .share-hint{font-size:11px;color:#3d2a52;text-align:center;letter-spacing:2px}
    .error-msg{font-size:13px;color:#9b6bae;text-align:center;padding:8px;display:none}
    .error-msg.show{display:block}
  </style>
</head>
<body>
<div class="app">
  <div class="header">
    <div class="header-sub">Shugo Chara Fan Magazine</div>
    <div class="header-title">나만의 <span>수호캐</span> 생성기</div>
    <div class="header-desc">당신의 마음의 알 안에는 어떤 수호캐가 있을까</div>
  </div>

  <svg class="lace" viewBox="0 0 520 16" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,8 Q32.5,0 65,8 Q97.5,16 130,8 Q162.5,0 195,8 Q227.5,16 260,8 Q292.5,0 325,8 Q357.5,16 390,8 Q422.5,0 455,8 Q487.5,16 520,8" fill="none" stroke="#3d2a52" stroke-width="0.8"/>
    <circle cx="65" cy="8" r="2" fill="#7c5c8a"/>
    <circle cx="195" cy="8" r="2" fill="#7c5c8a"/>
    <circle cx="325" cy="8" r="2" fill="#7c5c8a"/>
    <circle cx="455" cy="8" r="2" fill="#7c5c8a"/>
  </svg>

  <div class="form-block">
    <label class="form-label">지금 가장 간절히 원하는 것</label>
    <input class="form-input" id="dream" placeholder="자유, 인정받는 것, 진짜 친구..." maxlength="40"/>
  </div>

  <div class="form-block">
    <label class="form-label">나를 한 단어로 표현하면</label>
    <input class="form-input" id="self" placeholder="예민한, 강한 척하는, 조용한..." maxlength="20"/>
  </div>

  <div class="form-block">
    <label class="form-label">지금 내 마음에 숨겨둔 감정</label>
    <div class="options-row">
      <button class="opt-btn" onclick="selectOpt(this,'emotion')">지치고 번아웃</button>
      <button class="opt-btn" onclick="selectOpt(this,'emotion')">인정받고 싶음</button>
      <button class="opt-btn" onclick="selectOpt(this,'emotion')">뭔가 터뜨리고 싶음</button>
      <button class="opt-btn" onclick="selectOpt(this,'emotion')">그냥 사랑받고 싶음</button>
    </div>
  </div>

  <div class="form-block">
    <label class="form-label">나의 숨겨진 자아는</label>
    <div class="options-row">
      <button class="opt-btn" onclick="selectOpt(this,'hidden')">사실 되게 감성적</button>
      <button class="opt-btn" onclick="selectOpt(this,'hidden')">생각보다 반항기 있음</button>
      <button class="opt-btn" onclick="selectOpt(this,'hidden')">누구보다 다정함</button>
      <button class="opt-btn" onclick="selectOpt(this,'hidden')">완벽주의 기질 있음</button>
    </div>
  </div>

  <div class="error-msg" id="error-msg">입력칸을 채워줘</div>

  <button class="generate-btn" id="gen-btn" onclick="generate()">
    마음의 알을 열어보기
  </button>

  <div class="loading" id="loading">
    <span class="dot-anim">수호캐 소환 중</span>
  </div>

  <div class="result-box" id="result-box">
    <div class="result-label">당신의 수호캐</div>
    <div class="result-name" id="r-name"></div>
    <div class="result-type" id="r-type"></div>
    <div class="result-divider"></div>
    <div class="result-text" id="r-text"></div>
    <div class="result-tags" id="r-tags"></div>
    <div class="punk-deco">
      <div class="punk-line"></div>
      <span class="punk-symbol">✦</span>
      <div class="punk-line"></div>
    </div>
    <div class="share-hint">캡처해서 스토리에 올리고 계정 태그해줘 🖤</div>
  </div>
</div>

<script>
  const selected = {};

  function selectOpt(el, group) {
    el.closest('.options-row').querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    selected[group] = el.textContent.trim();
  }

  async function generate() {
    const dream = document.getElementById('dream').value.trim();
    const self = document.getElementById('self').value.trim();
    const errorMsg = document.getElementById('error-msg');

    if (!dream || !self) {
      errorMsg.classList.add('show');
      setTimeout(() => errorMsg.classList.remove('show'), 2000);
      return;
    }

    const btn = document.getElementById('gen-btn');
    const loading = document.getElementById('loading');
    const resultBox = document.getElementById('result-box');

    btn.disabled = true;
    loading.classList.add('show');
    resultBox.classList.remove('show');

    try {
      const res = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          dream,
          self,
          emotion: selected['emotion'] || '',
          hidden: selected['hidden'] || '',
        }),
      });

      const result = await res.json();

      document.getElementById('r-name').textContent = result.name;
      document.getElementById('r-type').textContent = result.type;
      document.getElementById('r-text').textContent = result.description;

      const tagsEl = document.getElementById('r-tags');
      tagsEl.innerHTML = '';
      (result.tags || []).forEach(t => {
        const span = document.createElement('span');
        span.className = 'result-tag';
        span.textContent = '#' + t;
        tagsEl.appendChild(span);
      });

      resultBox.classList.add('show');
    } catch (e) {
      document.getElementById('r-name').textContent = '소환 실패';
      document.getElementById('r-type').textContent = '마음의 알이 아직 준비 중이야';
      document.getElementById('r-text').textContent = '잠시 후 다시 시도해줘.';
      document.getElementById('r-tags').innerHTML = '';
      resultBox.classList.add('show');
    }

    loading.classList.remove('show');
    btn.disabled = false;
  }
</script>
</body>
</html>
